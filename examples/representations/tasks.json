    {
      "id": "unavailable-booking",
      "page": "booking.html",
      "request": {
        "intent": "answer",
        "kind": "node",
        "target": {
          "name": "9:00 AM",
          "role": "button",
          "scope": "Morning slots"
        },
        "field": "disabled"
      },
      "expected": true,
      "facts": [
        {
          "kind": "node",
          "target": {
            "name": "9:00 AM",
            "role": "button",
            "scope": "Morning slots"
          },
          "field": "disabled",
          "equals": true
        }
      ]
    },
    {
      "id": "reserve-first-available",
      "page": "booking.html",
      "request": {
        "intent": "reserve",
        "options": [
          {
            "name": "9:00 AM",
            "role": "button",
            "scope": "Morning slots"
          },
          {
            "name": "11:00 AM",
            "role": "button",
            "scope": "Morning slots"
          }
        ],
        "authorized": true
      },
      "expected": "Reserved 11:00 AM",
      "facts": [
        {
          "kind": "node",
          "target": {
            "name": "9:00 AM",
            "role": "button",
            "scope": "Morning slots"
          },
          "field": "disabled",
          "equals": true
        },
        {
          "kind": "node",
          "target": {
            "name": "11:00 AM",
            "role": "button",
            "scope": "Morning slots"
          },
          "field": "disabled",
          "equals": false
        }
      ]
    },
    {
      "id": "create-ticket",
      "page": "support.html",
      "request": {
        "intent": "submit",
        "target": {
          "name": "Ticket title",
          "role": "textbox"
        },
        "submit": {
          "name": "Create ticket",
          "role": "button"
        },
        "value": "Replace modem",
        "authorized": true
      },
      "expected": "Created: Replace modem",
      "facts": [
        {
          "kind": "node",
          "target": {
            "name": "Ticket title",
            "role": "textbox"
          },
          "field": "role",
          "equals": "textbox"
        },
        {
          "kind": "node",
          "target": {
            "name": "Ticket title",
            "role": "textbox"
          },
          "field": "required",
          "equals": true
        },
        {
          "kind": "node",
          "target": {
            "name": "Create ticket",
            "role": "button"
          },
          "field": "role",
          "equals": "button"
        }
      ]
    },
    {
