    {
      "id": "navigate-to-orders",
      "page": "index.html",
      "request": {
        "intent": "navigate",
        "target": {
          "name": "Orders",
          "role": "link"
        }
      },
      "expected": "/orders.html",
      "facts": [
        {
          "kind": "node",
          "target": {
            "name": "Orders",
            "role": "link"
          },
          "field": "role",
          "equals": "link"
        },
        {
          "kind": "node",
          "target": {
            "name": "Orders",
            "role": "link"
          },
          "field": "href",
          "equals": "/orders.html"
        }
      ]
    },
    {
      "id": "orders-link-destination",
      "page": "index.html",
