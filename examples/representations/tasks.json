    {
      "id": "typed-export-arguments",
      "page": "billing.html",
      "request": {
        "intent": "answer",
        "kind": "tool",
        "tool": "export_billing",
        "field": "inputSchema"
      },
      "expected": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json"
            ]
          }
        },
        "required": [
          "period",
          "format"
        ]
      },
      "facts": [
        {
          "kind": "tool",
          "tool": "export_billing",
          "field": "inputSchema",
          "equals": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "csv",
                  "json"
                ]
              }
            },
            "required": [
              "period",
              "format"
            ]
          }
        },
        {
          "kind": "tool",
          "tool": "export_billing",
          "field": "postconditions",
          "equals": [
            {
              "kind": "result-equals",
              "pointer": "/exported",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "withhold-unconfirmed-export",
      "page": "billing.html",
      "request": {
        "intent": "guard",
        "tool": "export_billing",
        "authorized": false
      },
      "expected": "approval-required",
      "facts": [
        {
          "kind": "tool",
          "tool": "export_billing",
          "field": "effect",
          "equals": "write"
        },
        {
          "kind": "tool",
          "tool": "export_billing",
          "field": "preconditions",
          "equals": [
            {
              "kind": "authentication",
              "boundary": "$fixture-origin",
              "anyOf": [
                {
                  "allOf": [
                    {
                      "type": "site-session",
                      "permissions": [
                        "billing:read"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "user-authorization",
              "when": "always",
              "scope": "this-capability-and-input"
            }
          ]
        }
      ]
    },
