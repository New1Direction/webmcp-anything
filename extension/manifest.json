{
  "manifest_version": 3,
  "name": "QuickCatch",
  "version": "0.2.0",
  "description": "Never miss a Pokémon drop again. Your AI watches the page and grabs the restock for you, even on sites that block bots.",
  "minimum_chrome_version": "132",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickCatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pokemoncenter.com/*",
        "https://*.walmart.com/*",
        "https://*.samsclub.com/*",
        "https://*.bestbuy.com/*",
        "https://*.target.com/*",
        "https://*.gamestop.com/*",
        "https://*.costco.com/*",
        "https://*.amazon.com/*",
        "https://*.tcgplayer.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://*.pokemoncenter.com/*",
        "https://*.walmart.com/*",
        "https://*.samsclub.com/*",
        "https://*.bestbuy.com/*",
        "https://*.target.com/*",
        "https://*.gamestop.com/*",
        "https://*.costco.com/*",
        "https://*.amazon.com/*",
        "https://*.tcgplayer.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://*.pokemoncenter.com/*",
    "https://*.walmart.com/*",
    "https://*.samsclub.com/*",
    "https://*.bestbuy.com/*",
    "https://*.target.com/*",
    "https://*.gamestop.com/*",
    "https://*.costco.com/*",
    "https://*.amazon.com/*",
    "https://*.tcgplayer.com/*",
    "https://wmcp.sh/*"
  ],
  "permissions": ["storage", "notifications"]
}
